# Also used for Account → Manage Subscription (https://<domain>/account).
SHOPIFY_STORE_DOMAIN=
# Optional full portal link. When set, Manage Subscription opens this URL instead.
SHOPIFY_MANAGE_SUBSCRIPTION_URL=
